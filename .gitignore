# IAAA contest dataset (large and potentially restricted)
/iaaa-contest-bct/Data/training/
/iaaa-contest-bct/Data/annotations/
/iaaa-contest-bct/Data/training_df.pkl

# Keep only the documentation placeholder for corrected annotations.
/iaaa-contest-bct/Data/annotations_corrected/*
!/iaaa-contest-bct/Data/annotations_corrected/README.md

# Locally rendered YOLO dataset variants, if output_root is changed from /dev/shm.
/fracture_dataset*/
/outputs/fracture_dataset*/

# Official development-time pretrained cache. Keep provenance metadata in git,
# but never commit the binary checkpoint; final inference uses trained best.pt.
/artifacts/pretrained/*.pt

# Generated training/runtime files. Existing tracked historical outputs are not
# removed by these rules, but new checkpoints and caches stay out of commits.
__pycache__/
*.py[cod]
.pytest_cache/
/outputs/
/models/deployment.yaml
/visualizations/reannotation/**/*.png
